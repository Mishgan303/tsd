AIRFLOW_UID=501
AIRFLOW_IMAGE_NAME=tsd-airflow:3.3.1
AIRFLOW_BASE_IMAGE=apache/airflow:3.3.1
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_METADATA_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_API_JWT_SECRET=
_PIP_ADDITIONAL_REQUIREMENTS=apache-airflow-providers-mongo apache-airflow-providers-amazon apache-airflow-providers-postgres==7.0.2 apache-airflow-providers-standard==1.19.0
ODS_USER=ods
ODS_PASSWORD=
ODS_DATABASE=ods
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=

SUPERSET_IMAGE=apache/superset:6.0.0
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_SECRET_KEY=
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=
SUPERSET_DB_NAME=superset

OPENMETADATA_POSTGRES_IMAGE=docker.getcollate.io/openmetadata/postgresql:1.12.6
OPENMETADATA_SERVER_IMAGE=docker.getcollate.io/openmetadata/server:1.12.6
OPENMETADATA_INGESTION_IMAGE=docker.getcollate.io/openmetadata/ingestion:1.12.6
OPENMETADATA_ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.3.0
OPENMETADATA_DB_ROOT_PASSWORD=
OPENMETADATA_HEAP_OPTS=-Xmx1G -Xms1G
OPENMETADATA_SEARCH_JAVA_OPTS=-Xms1G -Xmx1G
